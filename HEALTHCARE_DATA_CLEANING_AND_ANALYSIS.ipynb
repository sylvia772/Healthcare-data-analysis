        "## total revenue generated per month\n",
        "df[\"Admission_Date\"] = pd.to_datetime(df[\"Admission_Date\"], errors=\"coerce\")\n",
        "df[\"Month\"] = df[\"Admission_Date\"].dt.strftime('%y-%m')\n",
        "monthly_revenue = df.groupby('Month')[\"Billing_Amount\"].sum().reset_index()\n",
        "monthly_revenue"
